   725	impl CtmModel {
   726	    /// Per-document topic proportions θ = softmax([η, 0]).
   727	    pub fn doc_topics(&self) -> Vec<Vec<f64>> {
   728	        self.lambda
   729	            .iter()
   730	            .map(|eta| {
   731	                let e = expeta(eta);
   732	                let s: f64 = e.iter().sum();
   733	                e.iter().map(|x| x / s).collect()
   734	            })
   735	            .collect()
   736	    }
   737	
   738	    /// Topic correlation matrix: the correlation of the topic proportions θ
   739	    /// across documents (STM's practical `topicCorr`). Symmetric, unit diagonal,
   740	    /// defined over all K topics — captures which topics co-occur.
   741	    pub fn topic_correlation(&self) -> Vec<Vec<f64>> {
   742	        let k = self.num_topics;
   743	        let theta = self.doc_topics();
   744	        let d = theta.len().max(1) as f64;
   745	
   746	        let mut mean = vec![0.0f64; k];
   747	        for row in &theta {
   748	            for t in 0..k {
   749	                mean[t] += row[t];
   750	            }
   751	        }
   752	        for t in 0..k {
   753	            mean[t] /= d;
   754	        }
   755	        let mut cov = vec![vec![0.0f64; k]; k];
   756	        for row in &theta {
   757	            for i in 0..k {
   758	                for j in 0..k {
   759	                    cov[i][j] += (row[i] - mean[i]) * (row[j] - mean[j]);
   760	                }
   761	            }
   762	        }
   763	        let mut corr = vec![vec![0.0f64; k]; k];
   764	        for i in 0..k {
   765	            for j in 0..k {
   766	                let den = (cov[i][i] * cov[j][j]).sqrt();
   767	                corr[i][j] = if den > 0.0 {
   768	                    cov[i][j] / den
   769	                } else if i == j {
   770	                    1.0
   771	                } else {
   772	                    0.0
   773	                };
   774	            }
   775	        }
   776	        corr
   777	    }
   778	}
