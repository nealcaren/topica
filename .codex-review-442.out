  2491	        let sparse: Vec<(Vec<usize>, Vec<f64>)> = docs.iter().map(|d| doc_sparse(d)).collect();
  2492	        let stored = model.nu.clone(); // per-group E-step ν (keep_nu = true)
  2493	        assert_eq!(stored.len(), docs.len(), "nu stored per doc");
  2494	
  2495	        let mean_l1 = |a: &[Vec<f64>], b: &[Vec<f64>]| -> f64 {
  2496	            a.iter()
  2497	                .zip(b)
  2498	                .map(|(x, y)| x.iter().zip(y).map(|(p, q)| (p - q).abs()).sum::<f64>())
  2499	                .sum::<f64>()
  2500	                / a.len() as f64
  2501	        };
  2502	
  2503	        // Per-group reconstruction reproduces the stored ν essentially exactly:
  2504	        // `content_beta_estep` is the group β the E-step actually ran against, so
  2505	        // ctm_hpb at the stored λ returns the same ν (to machine precision).
  2506	        let recomputed = recompute_nu(&model, &sparse);
  2507	        let err_fixed = mean_l1(&stored, &recomputed);
  2508	
  2509	        // The pre-fix path used the group-averaged β for every document.
  2510	        model.groups = None;
  2511	        let shared_nu = recompute_nu(&model, &sparse);
  2512	        let err_shared = mean_l1(&stored, &shared_nu);
