  1717	    // model.sigma (which was updated by the final M-step and may differ).
  1718	    let sig = &model.sigma_estep;
  1719	    let siginv = crate::linalg::spd_inverse(sig, km1).unwrap_or_else(|| {
  1720	        let mut s = sig.clone();
  1721	        crate::linalg::make_diagonally_dominant(&mut s, km1);
  1722	        crate::linalg::spd_inverse_jitter(&s, km1)
  1723	    });
  1724	    let entropy = match crate::linalg::cholesky(sig, km1) {
  1725	        Some(l) => crate::linalg::half_logdet(&l, km1),
  1726	        None => 0.0,
  1727	    };
  1728	    (0..d)
  1729	        .into_par_iter()
  1730	        .map(|di| {
  1731	            let (words, counts) = &sparse[di];
  1732	            // For a content model the E-step ran each document against its own
  1733	            // group's topic-word distribution, so ν must be rebuilt the same way:
  1734	            // pick that group's β, not the group-averaged `beta_estep`. A fresh fit
  1735	            // carries `content_beta_estep` (the group β active during the final
  1736	            // E-step) and reproduces the stored ν exactly. A loaded content model
  1737	            // does not persist it (like `beta_estep`), so we fall back to the
  1738	            // post-M-step `content_beta` — the same one-M-step approximation the
  1739	            // shared path already accepts when `beta_estep` degrades to `beta` on
  1740	            // load. The prior mean does not enter the Hessian, so model.mu is used
  1741	            // for all documents.
  1742	            let beta_doc: &[Vec<f64>] = match (
  1743	                &model.content_beta_estep,
  1744	                &model.content_beta,
  1745	                &model.groups,
  1746	            ) {
  1747	                (Some(cbeta_estep), _, Some(groups)) => &cbeta_estep[groups[di]],
  1748	                (None, Some(cbeta), Some(groups)) => &cbeta[groups[di]],
  1749	                _ => &model.beta_estep,
  1750	            };
