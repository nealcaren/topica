  7876	    /// UMass topic coherence per topic, shape ``(num_topics,)``. `n` is the number
  7877	    /// of top words per topic scored.
  7878	    #[pyo3(signature = (n=10))]
  7879	    fn coherence<'py>(&self, py: Python<'py>, n: usize) -> PyResult<Bound<'py, PyArray1<f64>>> {
  7880	        self.require_fitted()?;
  7881	        let tops = top_word_ids_phi(self.beta.as_ref().unwrap(), self.num_topics, n);
