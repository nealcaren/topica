  2533	        let mut groups: Vec<usize> = Vec::new();
  2534	        for i in 0..120 {
  2535	            if i % 2 == 0 {
  2536	                docs.push(vec![0, 1, 0, 1, 0, 1]);
  2537	                groups.push(0);
  2538	            } else {
  2539	                docs.push(vec![2, 3, 2, 3, 2, 3]);
  2540	                groups.push(1);
  2541	            }
  2542	        }
  2543	        // em_iters = 1: exactly one E-step (against the initial content β) then one
  2544	        // M-step that overwrites content_beta. keep_nu = true stores the E-step ν.
  2545	        let mut model = fit_ctm(
  2546	            &docs,
  2547	            2,
  2548	            4,
  2549	            1,
  2550	            0.0,
  2551	            0.0,
  2552	            None,
  2553	            Some((&groups, 2)),
  2554	            None,
  2555	            1.0,
  2556	            0.0,
  2557	            false,
  2558	            None,
  2559	            GammaPrior::Pooled,
  2560	            true,
  2561	            false,
  2562	            &mut rng,
  2563	        );
  2564	        assert!(
  2565	            model.content_beta_estep.is_some(),
  2566	            "content_beta_estep captured for a fresh content fit"
  2567	        );
  2568	        // The final M-step must actually have moved content_beta, or the test would
  2569	        // pass trivially even against the buggy post-M-step path.
  2570	        let moved = {
