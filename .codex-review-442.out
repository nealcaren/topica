    15	/// Current on-disk format version.
    16	pub const FORMAT_VERSION: u8 = 1;
    17	
    18	/// Serialize `state` into a headed byte buffer (magic + version + tag + bincode).
    19	pub fn encode_state<S: serde::Serialize>(model_tag: u8, state: &S) -> Result<Vec<u8>, String> {
    20	    let payload = bincode::serialize(state).map_err(|e| format!("serialization failed: {e}"))?;
    21	    let mut buf = Vec::with_capacity(8 + payload.len());
    22	    buf.extend_from_slice(FILE_MAGIC);
    23	    buf.push(FORMAT_VERSION);
    24	    buf.push(model_tag);
    25	    buf.extend_from_slice(&payload);
    26	    Ok(buf)
    27	}
    28	
    29	/// Read just the model tag from a headed byte buffer, validating the magic and
    30	/// version. Used by models whose `load` accepts more than one tag (e.g. a class
    31	/// that absorbed a sibling's save format).
    32	pub fn peek_tag(bytes: &[u8]) -> Result<u8, String> {
    33	    if bytes.len() < 8 || &bytes[..6] != FILE_MAGIC {
    34	        return Err(
    35	            "not a topica model file (unrecognized header; file may be corrupt or saved by an older version)".into()
    36	        );
    37	    }
    38	    let version = bytes[6];
    39	    if version != FORMAT_VERSION {
    40	        return Err(format!(
    41	            "unsupported save-format version {version} (this build supports version {FORMAT_VERSION})"
    42	        ));
    43	    }
    44	    Ok(bytes[7])
    45	}
    46	
    47	/// Deserialize a byte buffer that was written by `encode_state`.
    48	/// Returns a clear error if the header is missing, wrong version, or wrong model tag.
    49	pub fn decode_state<S: serde::de::DeserializeOwned>(
    50	    bytes: &[u8],
    51	    expected_tag: u8,
    52	    tag_name: fn(u8) -> &'static str,
    53	) -> Result<S, String> {
    54	    if bytes.len() < 8 || &bytes[..6] != FILE_MAGIC {
    55	        return Err(
    56	            "not a topica model file (unrecognized header; file may be corrupt or saved by an older version)".into()
    57	        );
    58	    }
    59	    let version = bytes[6];
    60	    if version != FORMAT_VERSION {
    61	        return Err(format!(
    62	            "unsupported save-format version {version} (this build supports version {FORMAT_VERSION})"
    63	        ));
    64	    }
    65	    let file_tag = bytes[7];
