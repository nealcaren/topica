   366	    /// Covariate (group) deviations κ_cov, num_groups × V.
   367	    pub kappa_cov: Vec<Vec<f64>>,
   368	    /// Topic×group interaction deviations κ_interaction, (K·num_groups) × V,
   369	    /// indexed `topic * num_groups + group` (the layout `build_content_beta` uses).
   370	    pub kappa_interaction: Vec<Vec<f64>>,
   371	}
