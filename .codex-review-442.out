   353	/// The SAGE content-model κ decomposition (the additive parts of the per-group
   354	/// topic-word model): `log β_{k,a,v} = m_v + κ_topic_{k,v} + κ_cov_{a,v} +
   355	/// κ_interaction_{k,a,v}`, softmax-normalized over `v`. `content_beta` is derived
   356	/// from these; the κ pieces are the identifying information R `stm`'s
   357	/// `sageLabels()` / `labelTopics()` rank words by (and cannot be recovered from
   358	/// the per-group β alone).
   359	#[derive(Clone)]
   360	#[cfg_attr(feature = "serde", derive(serde::Serialize, serde::Deserialize))]
   361	pub struct ContentKappa {
   362	    /// Background log word-frequency `m`, length V.
   363	    pub m: Vec<f64>,
   364	    /// Topic deviations κ_topic, K × V.
