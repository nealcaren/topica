    43	pub(crate) const MODEL_TAG_COMBINEDTM: u8 = 24;
    44	pub(crate) const MODEL_TAG_ZEROSHOTTM: u8 = 25;
    45	pub(crate) const MODEL_TAG_DETM: u8 = 26;
    46	// 27 retired: ECTM removed (superseded by STM content_time); do not reuse.
    47	// 28-30 reserved for the parked experimental trio (HyperLDA/TopicRBM/DiffusionTM).
    48	pub(crate) const MODEL_TAG_IDEALPOINT: u8 = 31;
