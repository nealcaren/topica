[package]
name = "topica-core"
version = "0.1.0"
edition = "2021"
description = "Logistic-normal structural-topic-model core (CTM/STM/SAGE + CVB0) extracted from the topica crate: small, dependency-light, and independently vendorable."
license = "Apache-2.0"
repository = "https://github.com/nealcaren/topica"

[lib]
name = "topica_core"
path = "src/lib.rs"

[dependencies]
# Lean, pure-Rust, vendorable deps only — so downstream consumers (e.g. the faSTM
# R package on CRAN) can `cargo vendor` this crate without pulling pyo3/numpy/etc.
rand = "0.8"
rand_chacha = "0.3"   # ChaCha8 for the spectral random projection
rayon = "1"           # parallel variational E-step
regex = "1"           # corpus tokenizer (DEFAULT_TOKEN_REGEX)
# Serialization is opt-in: `topica` enables it; downstream minimal builds skip it.
serde = { version = "1", features = ["derive"], optional = true }

[dev-dependencies]
rand_pcg = "0.3"      # used only by the cvb0 unit tests

[features]
serde = ["dep:serde"]
src/saveformat.rs:3://! Every model's save() prepends an 8-byte header before the bincode payload:
src/saveformat.rs:8://!   bytes 8..  : bincode payload
src/saveformat.rs:10://! Old (headerless) files produced a bincode panic on mismatched struct layout;
src/saveformat.rs:18:/// Serialize `state` into a headed byte buffer (magic + version + tag + bincode).
src/saveformat.rs:19:pub fn encode_state<S: serde::Serialize>(model_tag: u8, state: &S) -> Result<Vec<u8>, String> {
