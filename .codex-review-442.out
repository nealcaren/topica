    61	pub(crate) fn model_tag_name(tag: u8) -> &'static str {
    62	    match tag {
    63	        MODEL_TAG_LDA => "LDA",
    64	        MODEL_TAG_DMR => "DMR",
    65	        MODEL_TAG_LABELED => "LabeledLDA",
    66	        MODEL_TAG_SAGE => "SAGE",
    67	        MODEL_TAG_CTM => "CTM",
    68	        MODEL_TAG_STM => "STM",
    69	        MODEL_TAG_STS => "STS",
    70	        MODEL_TAG_HDP => "HDP",
    71	        MODEL_TAG_DTM => "DTM",
    72	        MODEL_TAG_SLDA => "SupervisedLDA",
    73	        MODEL_TAG_PT => "PT",
    74	        MODEL_TAG_GSDMM => "GSDMM",
    75	        MODEL_TAG_SEEDED => "SeededLDA",
    76	        MODEL_TAG_TOP2VEC => "Top2Vec",
    77	        MODEL_TAG_BERTOPIC => "BERTopic",
    78	        MODEL_TAG_ETM => "ETM",
    79	        MODEL_TAG_PRODLDA => "ProdLDA",
    80	        MODEL_TAG_FASTOPIC => "FASTopic",
    81	        MODEL_TAG_KEYATM => "KeyATM",
    82	        MODEL_TAG_PA => "PA",
    83	        MODEL_TAG_HLDA => "HLDA",
    84	        MODEL_TAG_NMF => "NMF",
    85	        MODEL_TAG_LSA => "LSA",
    86	        MODEL_TAG_COMBINEDTM => "CombinedTM",
    87	        MODEL_TAG_ZEROSHOTTM => "ZeroShotTM",
    88	        MODEL_TAG_DETM => "DETM",
    89	        // Tags 31 and 33 are both IdealPointTM: word-embedding and count
    90	        // representations of the same model, merged into one pyclass.
    91	        MODEL_TAG_IDEALPOINT => "IdealPointTM",
    92	        MODEL_TAG_WORDFISH => "Wordfish",
    93	        MODEL_TAG_IDEALPOINT_LDA => "IdealPointTM",
    94	        MODEL_TAG_SENTENCE_IDEAL => "IdealPointSentenceTM",
    95	        MODEL_TAG_TBIP => "TBIP",
    96	        MODEL_TAG_PARTY_EMBEDDINGS => "PartyEmbeddings",
    97	        MODEL_TAG_TLDA => "TensorLDA",
    98	        MODEL_TAG_BTM => "BTM",
    99	        MODEL_TAG_PLTM => "PolylingualLDA",
   100	        MODEL_TAG_DISCLDA => "DiscLDA",
   101	        MODEL_TAG_SCHOLAR => "Scholar",
   102	        MODEL_TAG_RTM => "RTM",
   103	        _ => "unknown",
   104	    }
   105	}
   106	
   107	pub(crate) fn write_state<S: serde::Serialize>(
   108	    path: &str,
   109	    model_tag: u8,
   110	    state: &S,
   111	) -> PyResult<()> {
   112	    let buf = crate::saveformat::encode_state(model_tag, state).map_err(PyValueError::new_err)?;
   113	    std::fs::write(path, buf).map_err(io_err)
   114	}
   115	pub(crate) fn read_state<S: serde::de::DeserializeOwned>(
   116	    path: &str,
   117	    expected_tag: u8,
   118	) -> PyResult<S> {
   119	    let bytes = std::fs::read(path).map_err(io_err)?;
   120	    crate::saveformat::decode_state(&bytes, expected_tag, model_tag_name)
   121	        .map_err(PyValueError::new_err)
   122	}
   123	
   124	/// Read just the model tag from a save file, for classes whose `load` dispatches
   125	/// on the tag (e.g. IdealPointTM, which reads both its word-embedding and count
   126	/// save formats).
   127	pub(crate) fn peek_model_tag(path: &str) -> PyResult<u8> {
   128	    let bytes = std::fs::read(path).map_err(io_err)?;
   129	    crate::saveformat::peek_tag(&bytes).map_err(PyValueError::new_err)
   130	}
