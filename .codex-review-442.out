  7884	    }
  7885	
  7886	    /// Infer topic proportions θ for *new* documents by the variational E-step
  7887	    /// against the fitted globals (β and the logistic-normal prior). `data` is a
  7888	    /// :class:`Corpus` or `list[list[str]]`; out-of-vocabulary tokens are dropped.
  7889	    /// Returns a ``(num_docs, num_topics)`` array.
  7890	    ///
  7891	    /// When `eta_prior_mean` is ``None`` (the default), the covariate-free
  7892	    /// baseline μ learned at fit time is used for every document — the same
  7893	    /// inference that ``stm``'s ``fitNewDocuments`` performs when no new
  7894	    /// covariate design is supplied.
  7895	    ///
  7896	    /// When `eta_prior_mean` is a ``(num_docs, num_topics-1)`` array, each
  7897	    /// document's prior mean is set to the corresponding row.  This is the
  7898	    /// low-level hook used by :func:`topica.stm.transform` to apply the
  7899	    /// prevalence-covariate prior ``μ_d = X_d γ`` to held-out documents.
  7900	    #[pyo3(signature = (data, *, eta_prior_mean=None))]
  7901	    fn transform<'py>(
  7902	        &self,
  7903	        py: Python<'py>,
  7904	        data: &Bound<'py, PyAny>,
  7905	        eta_prior_mean: Option<PyReadonlyArray2<'py, f64>>,
  7906	    ) -> PyResult<Bound<'py, PyArray2<f64>>> {
  7907	        self.require_fitted()?;
  7908	        let docs = docs_to_ids(data, &self.corpus.as_ref().unwrap().id_to_word)?;
  7909	        let beta = self.beta.as_ref().unwrap();
  7910	        let beta_v: Vec<Vec<f64>> = beta.outer_iter().map(|r| r.to_vec()).collect();
  7911	        let theta = if let Some(mu_arr) = eta_prior_mean {
  7912	            let mu_nd = mu_arr.as_array();
  7913	            let nd = docs.len();
  7914	            let km1 = self.mu.len();
  7915	            if mu_nd.shape() != [nd, km1] {
  7916	                return Err(PyValueError::new_err(format!(
  7917	                    "eta_prior_mean must have shape ({nd}, {km1}); got {:?}",
  7918	                    mu_nd.shape()
  7919	                )));
  7920	            }
  7921	            let owned = mu_nd.to_owned();
  7922	            infer_theta_batch_per_doc(py, &beta_v, &owned, &self.sigma, &docs)
  7923	        } else {
  7924	            infer_theta_batch(py, &beta_v, &self.mu, &self.sigma, &docs)
  7925	        };
  7926	        Ok(theta.to_pyarray_bound(py))
  7927	    }
