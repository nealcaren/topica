   379	    pub sigma: Vec<f64>,       // (K-1)² prior covariance
   380	    pub lambda: Vec<Vec<f64>>, // per-doc variational means η (K-1)
   381	    /// Per-document variational covariance ν = H⁻¹ ((K-1)² flattened, row-major),
   382	    /// from the final E-step — the Laplace posterior of η used for
   383	    /// method-of-composition uncertainty.  Empty when the model was fit with
   384	    /// `keep_nu = false`; use `recompute_nu` to regenerate on demand.
   385	    pub nu: Vec<Vec<f64>>,
   386	    /// The prior covariance Σ that was used in the final E-step (the sigma that
   387	    /// produced the stored λ and ν values). For `fit_ctm`, this is the sigma from
   388	    /// the M-step of the penultimate EM iteration (one step behind `sigma`).
   389	    /// For `fit_ctm_svi`, this equals `sigma` (the final E-step uses the converged
   390	    /// globals). Used by `recompute_nu` to exactly reproduce the stored ν.
   391	    pub sigma_estep: Vec<f64>,
   392	    /// The topic-word matrix β (K×V) that was used in the final E-step (before
   393	    /// the final M-step updated `beta`). For `fit_ctm`, this is β from the
   394	    /// penultimate M-step. For `fit_ctm_svi`, this equals `beta` (no M-step
   395	    /// follows the final E-step). Used by `recompute_nu` to reproduce ν exactly.
   396	    pub beta_estep: Vec<Vec<f64>>,
   397	    /// Prevalence coefficients γ (num_features × (K-1)), `Some` when prevalence
   398	    /// covariates were supplied: `μ_d = X_d γ`. The last topic is the reference.
   399	    pub gamma: Option<Vec<Vec<f64>>>,
   400	    /// Per-group topic-word distributions (G × K × V), `Some` when content
   401	    /// covariates were supplied (the SAGE content model inside STM). `beta` is
   402	    /// then the group-averaged topic-word.
   403	    pub content_beta: Option<Vec<Vec<Vec<f64>>>>,
   404	    /// SAGE κ decomposition behind `content_beta`, `Some` when content covariates
   405	    /// were supplied. See [`ContentKappa`].
   406	    pub content_kappa: Option<ContentKappa>,
   407	    pub num_groups: usize,
   408	    /// Per-document group index (length D), `Some` alongside `content_beta` when
   409	    /// content covariates were supplied. `recompute_nu` needs it to rebuild each
   410	    /// document's ν with its own group's topic-word distribution rather than the
   411	    /// group-averaged `beta`.
   412	    pub groups: Option<Vec<usize>>,
   413	    /// Corpus approximate evidence bound (ELBO) at the final E-step — the same
   414	    /// quantity R `stm` reports as its convergence bound.
   415	    pub bound: f64,
   416	    /// Approximate bound after each EM iteration (the convergence trajectory,
   417	    /// one entry per iteration run).
   418	    pub bound_history: Vec<f64>,
   419	    /// `true` if EM stopped on the `em_tol` relative-bound criterion, `false`
   420	    /// if it hit the `em_iters` cap first.
