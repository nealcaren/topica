     1	//! Model save/load plumbing: the per-model tag table and the generic
     2	//! `write_state`/`read_state` wrappers over `crate::saveformat`.
     3	//!
     4	//! Save-file header (8 bytes prepended before the bincode payload):
     5	//!   bytes 0..6  : b"TOPICA"   (magic, 6 bytes)
     6	//!   byte  6     : format version u8 = 1
     7	//!   byte  7     : model tag u8 (see MODEL_TAG_* constants below)
     8	//!   bytes 8..   : bincode payload
     9	//!
    10	//! Header encode/decode logic lives in `src/saveformat.rs` (always compiled, so
    11	//! it can have Rust unit tests without the `python` feature gate or libpython).
    12	//! Old (headerless) files produce a clear "not a topica model file" error rather
    13	//! than a bincode panic.
    14	
    15	use super::error::io_err;
    16	use pyo3::exceptions::PyValueError;
    17	use pyo3::PyResult;
    18	
    19	// One tag per concrete model type that calls write_state / read_state.
    20	pub(crate) const MODEL_TAG_LDA: u8 = 1;
    21	pub(crate) const MODEL_TAG_DMR: u8 = 2;
    22	pub(crate) const MODEL_TAG_LABELED: u8 = 3;
    23	pub(crate) const MODEL_TAG_SAGE: u8 = 4;
    24	pub(crate) const MODEL_TAG_CTM: u8 = 5;
    25	pub(crate) const MODEL_TAG_STM: u8 = 6;
    26	pub(crate) const MODEL_TAG_STS: u8 = 7;
    27	pub(crate) const MODEL_TAG_HDP: u8 = 8;
    28	pub(crate) const MODEL_TAG_DTM: u8 = 9;
    29	pub(crate) const MODEL_TAG_SLDA: u8 = 10;
    30	pub(crate) const MODEL_TAG_PT: u8 = 11;
    31	pub(crate) const MODEL_TAG_GSDMM: u8 = 12;
    32	pub(crate) const MODEL_TAG_SEEDED: u8 = 13;
    33	pub(crate) const MODEL_TAG_TOP2VEC: u8 = 14;
    34	pub(crate) const MODEL_TAG_BERTOPIC: u8 = 15;
    35	pub(crate) const MODEL_TAG_ETM: u8 = 16;
    36	pub(crate) const MODEL_TAG_PRODLDA: u8 = 17;
    37	pub(crate) const MODEL_TAG_FASTOPIC: u8 = 18;
    38	pub(crate) const MODEL_TAG_KEYATM: u8 = 19;
    39	pub(crate) const MODEL_TAG_PA: u8 = 20;
    40	pub(crate) const MODEL_TAG_HLDA: u8 = 21;
